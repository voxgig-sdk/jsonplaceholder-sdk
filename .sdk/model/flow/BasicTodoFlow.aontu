# BasicTodoFlow

main: kit: flow: BasicTodoFlow:
{
  entity: "todo",
  kind: "basic",
  name: "BasicTodoFlow",
  step: [
    {
      i: {
        ref: "todo_ref01"
      }

      m: {
        user_id: "user01"
      }

      o: "create"
    }

    {
      m: {
        user_id: "user01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "todo_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "todo_ref01",
        srcdatavar: "todo_ref01_data",
        suffix: "_up0",
        textfield: "title"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-todo_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "todo_ref01",
        srcdatavar: "todo_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "todo01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-todo_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "todo_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "todo01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        user_id: "user01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "todo_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTodoFlow"
}