# BasicPostFlow

main: kit: flow: BasicPostFlow:
{
  entity: "post",
  kind: "basic",
  name: "BasicPostFlow",
  step: [
    {
      i: {
        ref: "post_ref01"
      }

      m: {
        user_id: "user01"
      }

      o: "create"
    }

    {
      m: {
        user_id: "user01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "post_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "post_ref01",
        srcdatavar: "post_ref01_data",
        suffix: "_up0",
        textfield: "body"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-post_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "post_ref01",
        srcdatavar: "post_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "post01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-post_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "post_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "post01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        user_id: "user01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "post_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPostFlow"
}