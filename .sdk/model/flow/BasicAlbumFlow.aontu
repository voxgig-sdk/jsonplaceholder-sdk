# BasicAlbumFlow

main: kit: flow: BasicAlbumFlow:
{
  entity: "album",
  kind: "basic",
  name: "BasicAlbumFlow",
  step: [
    {
      i: {
        ref: "album_ref01"
      }

      m: {
        user_id: "user01"
      }

      o: "create"
    }

    {
      m: {
        user_id: "user01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "album_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "album_ref01",
        srcdatavar: "album_ref01_data",
        suffix: "_up0",
        textfield: "title"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-album_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "album_ref01",
        srcdatavar: "album_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "album01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-album_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "album_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "album01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        user_id: "user01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "album_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAlbumFlow"
}