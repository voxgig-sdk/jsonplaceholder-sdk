# BasicPhotoFlow

main: kit: flow: BasicPhotoFlow:
{
  entity: "photo",
  kind: "basic",
  name: "BasicPhotoFlow",
  step: [
    {
      i: {
        ref: "photo_ref01"
      }

      m: {
        album_id: "album01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "photo_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "photo_ref01",
        srcdatavar: "photo_ref01_data",
        suffix: "_up0",
        textfield: "thumbnailUrl"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-photo_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "photo_ref01",
        srcdatavar: "photo_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "photo01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-photo_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "photo_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "photo01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "photo_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPhotoFlow"
}