# BasicPhotoFlow

main: kit: flow: BasicPhotoFlow:
{
  entity: "photo",
  kind: "basic",
  name: "BasicPhotoFlow",
  step: [
    {
      input: {
        ref: "photo_ref01"
      }

      match: {
        album_id: "album01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "photo_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "photo_ref01",
        srcdatavar: "photo_ref01_data",
        suffix: "_up0",
        textfield: "thumbnail_url"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-photo_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "photo_ref01",
        srcdatavar: "photo_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "photo01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-photo_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "photo_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "photo01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "photo_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPhotoFlow"
}